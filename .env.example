PORT=3000
NODE_ENV=development
API_PREFIX=api
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3000
# Optional: use this instead of the individual DATABASE_* values for hosted PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nestjs_app
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Required to use authenticated user endpoints. For example: https://your-project.supabase.co
# SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Required when enabling Stripe checkout and webhook handling.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional overrides. By default, URLs use the first CORS_ORIGINS origin:
# /payment/success?session_id={CHECKOUT_SESSION_ID} and /cart.
# STRIPE_CHECKOUT_SUCCESS_URL=https://app.example.com/payment/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=https://app.example.com/cart
